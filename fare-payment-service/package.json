    "db:seed": "ts-node src/database/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "microservices",
    "ride-sharing",
    "fare-service",
    "payment-service",
    "typescript",
    "express",
    "prisma"
